```tsx
// BlurText: use em todo h1/h2 (por palavras, atraso 110ms)
export function BlurText({ text, delay = 110, as: Tag = "h2" }: { text: string; delay?: number; as?: any }) {
  const ref = useRef<HTMLElement>(null);
  const rm = typeof matchMedia !== "undefined" && matchMedia("(prefers-reduced-motion: reduce)").matches;
  useEffect(() => {
    if (rm || !ref.current) return;
    const spans = ref.current.querySelectorAll("span");
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return; io.disconnect();
      spans.forEach((s, i) => s.animate([
        { filter: "blur(10px)", opacity: 0, transform: "translateY(-50px)" },
        { filter: "blur(5px)", opacity: .5, transform: "translateY(5px)", offset: .5 },
        { filter: "blur(0)", opacity: 1, transform: "translateY(0)" }],
        { duration: 700, delay: i * delay, fill: "both", easing: "linear" }));
    }, { threshold: .1 });
    io.observe(ref.current); return () => io.disconnect();
  }, [text, rm]);
  return <Tag ref={ref} aria-label={text} style={{ display: "flex", flexWrap: "wrap" }}>
    {text.split(" ").map((w, i) => <span key={i} aria-hidden style={{ display: "inline-block", opacity: rm ? 1 : 0 }}>{w}&nbsp;</span>)}
  </Tag>;
}

// Score contando (900ms, easing cúbico), vírgula decimal
export function useCountUp(to: number, ms = 900, dec = 1) {
  const [v, setV] = useState(0);
  useEffect(() => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) { setV(to); return; }
    let t0: number | null = null, raf = 0;
    const f = (t: number) => { t0 ??= t; const p = Math.min((t - t0) / ms, 1);
      setV(to * (1 - Math.pow(1 - p, 3))); if (p < 1) raf = requestAnimationFrame(f); };
    raf = requestAnimationFrame(f); return () => cancelAnimationFrame(raf);
  }, [to, ms]);
  return v.toFixed(dec).replace(".", ",");
}
```
